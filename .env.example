# Placeholder names only — never put real values here (guide §4.3).
# Real secrets live in the proxy host's environment:
#   Cloudflare:  wrangler secret put ANTHROPIC_API_KEY / APP_AUTH_TOKEN
#   Vercel:      set in Project Settings → Environment Variables
# For local proxy dev, copy proxy/.dev.vars.example → proxy/.dev.vars (git-ignored).

# Anthropic API key from console.anthropic.com. NEVER ships in the APK.
ANTHROPIC_API_KEY=

# Long random string (e.g. `openssl rand -hex 32`). The Quest app sends this as
# the X-App-Token header; it also goes into the Unity AssistantConfig asset.
APP_AUTH_TOKEN=
